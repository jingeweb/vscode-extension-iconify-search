{
  "name": "iconify-search",
  "displayName": "Iconify Search",
  "version": "1.0.3",
  "private": true,
  "description": "Search Iconify Icons in VS Code",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuhangGe/vscode-extension-iconify-search.git"
  },
  "publisher": "geekabe",
  "type": "module",
  "main": "./out/extension.cjs",
  "scripts": {
    "build": "rm -rf out && pnpm build:webview:iconify && pnpm build:extension",
    "build:extension": "vite build -c scripts/vite.extension.config.ts",
    "build:webview:iconify": "vite build -c scripts/vite.webview.config.ts -- iconify",
    "dev:webview:iconify": "vite dev -c scripts/vite.webview.config.ts -- iconify",
    "format": "oxfmt",
    "lint": "pnpm typecheck && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "tsx --test tests/*.test.mjs",
    "test:webview": "tsx --test tests/browser/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "vscode:prepublish": "npm run build",
    "watch:extension": "vite build -c scripts/vite.extension.config.ts -- --watch",
    "watch:webview:iconify": "vite build -c scripts/vite.webview.config.ts -- iconify --watch"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "jinge": "^4.2.1",
    "proper-lockfile": "^4.1.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@iconify-json/codicon": "^1.2.77",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "^1.144.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/l10n-dev": "^0.0.35",
    "husky": "^9.1.7",
    "jinge-compiler": "^4.2.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "oxfmt"
    ]
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "iconify.search",
        "title": "%iconifySearch.command.search%",
        "category": "Iconify"
      },
      {
        "command": "iconify.view.all",
        "title": "%iconifySearch.command.view.all%",
        "category": "Iconify"
      },
      {
        "command": "iconify.view.favorites",
        "title": "%iconifySearch.command.view.favorites%",
        "category": "Iconify"
      }
    ],
    "configuration": [
      {
        "title": "Iconify Search",
        "properties": {
          "iconifySearch.favorTabs": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Icon Category"
            },
            "default": [],
            "description": "%settings.favor.tabs%"
          },
          "iconifySearch.favorIcons": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Icon Id"
            },
            "default": [],
            "description": "%settings.favor.icons%"
          },
          "iconifySearch.favorGroup": {
            "type": "string",
            "default": "",
            "description": "%settings.favor.group%"
          },
          "iconifySearch.codeType": {
            "type": "string",
            "default": "tailwindcss-react",
            "enum": [
              "name",
              "svg",
              "react",
              "vue",
              "tailwindcss",
              "tailwindcss-react",
              "iconify-icon",
              "iconify-react",
              "unplugin-icons",
              "unocss",
              "unocss-react"
            ],
            "description": "%settings.code-type%"
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.145.0"
  }
}
