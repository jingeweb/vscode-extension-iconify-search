{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Webview HMR)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.cjs"],
      "preLaunchTask": "dev",
      "env": {
        "ICONIFY_WEBVIEW_DEV_SERVER_URL": "http://127.0.0.1:5173"
      }
    },
    {
      "name": "Run Extension (Production Build)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.cjs"],
      "preLaunchTask": "build",
      "env": { "ICONIFY_WEBVIEW_DEV_SERVER_URL": null }
    }
  ]
}
