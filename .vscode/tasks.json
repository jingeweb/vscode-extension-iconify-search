{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:extension",
      "type": "shell",
      "command": "pnpm watch:extension",
      "isBackground": true,
      "options": {
        "env": {
          "NO_COLOR": "1"
        }
      },
      "problemMatcher": {
        "owner": "iconify-extension",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started",
          "endsPattern": "ICONIFY_EXTENSION_READY"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "dev:webview",
      "type": "shell",
      "command": "pnpm dev:webview:iconify",
      "isBackground": true,
      "options": {
        "env": {
          "NO_COLOR": "1"
        }
      },
      "problemMatcher": {
        "owner": "iconify-webview",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*ready",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173/"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "dev",
      "dependsOn": ["dev:extension", "dev:webview"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "problemMatcher": []
    }
  ]
}
